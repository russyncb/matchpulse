ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (used by both the db container and the API)
POSTGRES_USER=matchpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matchpulse

# Sportmonks (free plan token from my.sportmonks.com). Never commit the real value.
SPORTMONKS_API_TOKEN=

# Worker (all optional; these are the defaults)
# ACTIVE_PROVIDER=sportmonks        # or "replay" to run a scripted demo match, no API calls
# SPORTMONKS_TRACKED_LEAGUES=271,501
# LIVE_POLL_SECONDS=60
# SNAPSHOT_INTERVAL_SECONDS=300
